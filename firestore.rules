rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // GANTI "GANTI_DENGAN_UID_ADMIN" dengan UID akun admin
    // (Firebase Console > Authentication > Users > kolom "User UID").
    // UID tidak berubah walaupun email admin diganti.
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid == "GANTI_DENGAN_UID_ADMIN"
            || request.auth.token.email == "alex@insurance.com");
      // Setelah UID diisi, HAPUS baris email di atas agar aman
      // ketika email admin nanti diganti.
    }

    // Pengaturan rate, daftar kendaraan, dan foto header:
    // semua orang boleh membaca, hanya admin yang boleh mengubah.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Riwayat penawaran: hanya admin.
    match /quotes/{quoteId} {
      allow read, write: if isAdmin();
    }

    // Tanya Admin: pengunjung hanya boleh MENGIRIM pesan baru dengan isi yang valid.
    // Membaca, membalas (ubah status), dan menghapus hanya admin.
    match /inbox/{msgId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'message', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9 && request.resource.data.phone.size() <= 20
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'baru'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Semua koleksi lain tertutup.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
